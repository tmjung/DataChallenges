# =============================================================================
# MaxEnt with CSV-based environmental variables
# No external .tif raster required
# =============================================================================

library(tidyverse)
library(sf)
library(maxnet)
library(rnaturalearth)
library(rnaturalearthdata)
library(viridis)
library(ggplot2)
library(pROC)

# 1. Load CSV ---------------------------------------------------------------

fix_decimal <- function(x) {
  if (is.character(x)) {
    x <- gsub(",", ".", x)
    x <- gsub("[^0-9.\\-]", "", x)
    as.numeric(x)
  } else {
    x
  }
}

raw <- read_csv(
  "ffm_vfpa_eisenzeit.csv",
  locale = locale(decimal_mark = ","),
  col_types = cols(
    lng_wgs84 = col_character(),
    lat_wgs84 = col_character()
  ),
  show_col_types = FALSE
)

feature_cols <- c(
  "Höhe_SRTM1_puffer50m",
  "Neigung_SRTM1_puffer50m",
  "Hangausrichtung_SRTM1_puffer50m",
  "Loess_1zu500k_puffer50m",
  "Wasser_puffer50m",
  "Viewshed_km2",
  "Umfeldanalyse_km2",
  "Reliefenergie",
  "Frosttage_Jahr",
  "Niederschlag_Jahr",
  "Sonnenstunden_Jahr",
  "Temperatur_Jahr"
)

df <- raw %>%
  mutate(across(all_of(feature_cols), fix_decimal)) %>%
  mutate(
    lng = as.numeric(gsub(",", ".", lng_wgs84)),
    lat = as.numeric(gsub(",", ".", lat_wgs84))
  ) %>%
  select(lng, lat, all_of(feature_cols)) %>%
  drop_na()

presence_df <- df %>%
  slice_sample(n = min(1000, nrow(df))) %>%
  mutate(presence = 1)

cat("Presence points:", nrow(presence_df), "\n")

# 2. Bavaria boundary -------------------------------------------------------

states_raw <- ne_download(
  scale = 10,
  type = "states",
  category = "cultural",
  returnclass = "sf"
)

bavaria_sf <- states_raw %>%
  filter(admin == "Germany", name_de == "Bayern") %>%
  st_transform(4326)

bbox_bavaria <- c(xmin = 8.9, xmax = 13.9, ymin = 47.2, ymax = 50.6)

# 3. Generate background points --------------------------------------------

set.seed(42)

presence_sf <- st_as_sf(
  presence_df,
  coords = c("lng", "lat"),
  crs = 4326,
  remove = FALSE
)

n_background <- nrow(presence_df) * 2

candidate_bg <- st_sample(
  bavaria_sf,
  size = n_background * 5
) %>%
  st_as_sf() %>%
  st_set_crs(4326)

dist_mat <- st_distance(candidate_bg, presence_sf)
dist_mat_num <- matrix(
  as.numeric(dist_mat),
  nrow = nrow(candidate_bg),
  ncol = nrow(presence_sf)
)

min_dist <- apply(dist_mat_num, 1, min)

selected <- which(min_dist > 5000)
selected <- selected[seq_len(min(length(selected), n_background))]

background_sf <- candidate_bg[selected, ]

background_df <- st_coordinates(background_sf) %>%
  as.data.frame() %>%
  rename(lng = X, lat = Y)

cat("Background points:", nrow(background_df), "\n")

# 4. Assign environmental values to background ------------------------------
# Method: Inverse Distance Weighting(IDW)

assign_idw_env <- function(target_coords, source_df, k = 8, power = 2) {
  source_coords <- as.matrix(source_df[, c("lng", "lat")])
  source_env <- source_df[, feature_cols]

  result <- lapply(seq_len(nrow(target_coords)), function(i) {
    d <- sqrt(
      (source_coords[, 1] - target_coords[i, 1])^2 +
        (source_coords[, 2] - target_coords[i, 2])^2
    )

    nearest_ids <- order(d)[1:k]
    nearest_d <- d[nearest_ids]

    nearest_d[nearest_d == 0] <- 1e-10

    weights <- 1 / (nearest_d ^ power)
    weights <- weights / sum(weights)

    env_values <- source_env[nearest_ids, , drop = FALSE]

    colSums(env_values * weights, na.rm = TRUE)
  })

  as.data.frame(do.call(rbind, result))
}

background_env <- assign_idw_env(
  target_coords = as.matrix(background_df[, c("lng", "lat")]),
  source_df = presence_df,
  k = 8,
  power = 2
)

background_df <- bind_cols(background_df, background_env) %>%
  mutate(presence = 0)

# 5. Prepare train/test data ------------------------------------------------

train_all <- bind_rows(
  presence_df %>% select(presence, all_of(feature_cols)),
  background_df %>% select(presence, all_of(feature_cols))
) %>%
  drop_na()

set.seed(123)

test_idx <- sample(
  seq_len(nrow(train_all)),
  size = floor(0.25 * nrow(train_all))
)

test_df <- train_all[test_idx, ]
train_df <- train_all[-test_idx, ]

train_p <- train_df$presence
train_x <- train_df %>% select(-presence)

# 6. Train MaxEnt -----------------------------------------------------------

mx_formula <- maxnet.formula(
  p = train_p,
  data = train_x,
  classes = "lqph"
)

mx <- maxnet(
  p = train_p,
  data = train_x,
  f = mx_formula,
  regmult = 1.5
)

cat("MaxEnt model trained.\n")

# 7. AUC + ROC evaluation ---------------------------------------------------

test_x <- test_df %>%
  select(-presence) %>%
  as.data.frame()

test_pred <- predict(
  mx,
  newdata = test_x,
  type = "logistic"
)

roc_obj <- roc(
  response = test_df$presence,
  predictor = test_pred,
  levels = c(0, 1),
  direction = "<"
)

auc_value <- auc(roc_obj)

cat("Test AUC:", round(as.numeric(auc_value), 4), "\n")

roc_df <- data.frame(
  specificity = roc_obj$specificities,
  sensitivity = roc_obj$sensitivities
)

p_roc <- ggplot(
  roc_df,
  aes(x = 1 - specificity, y = sensitivity)
) +
  geom_line(linewidth = 1) +
  geom_abline(
    intercept = 0,
    slope = 1,
    linetype = "dashed"
  ) +
  coord_equal() +
  labs(
    title = "ROC-Kurve des MaxEnt-Modells",
    subtitle = paste("AUC =", round(as.numeric(auc_value), 3)),
    x = "False Positive Rate",
    y = "True Positive Rate"
  ) +
  theme_minimal()

print(p_roc)

ggsave(
  "maxent_csv_env_ROC.png",
  plot = p_roc,
  width = 7,
  height = 6,
  dpi = 300
)

# 8. Create prediction grid -------------------------------------------------

res_deg <- 0.03

grid <- expand.grid(
  lng = seq(bbox_bavaria["xmin"], bbox_bavaria["xmax"], by = res_deg),
  lat = seq(bbox_bavaria["ymin"], bbox_bavaria["ymax"], by = res_deg)
)

grid_sf <- st_as_sf(
  grid,
  coords = c("lng", "lat"),
  crs = 4326,
  remove = FALSE
)

inside_bavaria <- lengths(st_intersects(grid_sf, bavaria_sf)) > 0

pred_grid <- grid[inside_bavaria, ]

cat("Prediction grid points:", nrow(pred_grid), "\n")

# 9. Assign environmental values to grid ------------------------------------

grid_env <- assign_idw_env(
  target_coords = as.matrix(pred_grid[, c("lng", "lat")]),
  source_df = presence_df,
  k = 8,
  power = 2
)

pred_grid <- bind_cols(pred_grid, grid_env)

# 10. Predict suitability ---------------------------------------------------

pred_x <- pred_grid %>%
  select(all_of(feature_cols)) %>%
  as.data.frame()

pred_grid$suitability <- predict(
  mx,
  newdata = pred_x,
  type = "logistic"
)

# 11. Plot prediction map ---------------------------------------------------

p_map <- ggplot() +
  geom_raster(
    data = pred_grid,
    aes(x = lng, y = lat, fill = suitability)
  ) +
  geom_sf(
    data = bavaria_sf,
    fill = NA,
    color = "black",
    linewidth = 0.4
  ) +
  geom_point(
    data = presence_df,
    aes(x = lng, y = lat),
    color = "red",
    size = 0.7,
    alpha = 0.6
  ) +
  scale_fill_viridis_c(
    option = "viridis",
    name = "Eignung"
  ) +
  coord_sf(
    xlim = c(bbox_bavaria["xmin"], bbox_bavaria["xmax"]),
    ylim = c(bbox_bavaria["ymin"], bbox_bavaria["ymax"]),
    expand = FALSE
  ) +
  labs(
    title = "MaxEnt-Prediction mit CSV-Umweltvariablen",
    subtitle = paste(
  "Prädiktoren aus CSV | Umweltwerte durch IDW-Interpolation | AUC =",
  round(as.numeric(auc_value), 3)
),
    x = "Längengrad",
    y = "Breitengrad"
  ) +
  theme_minimal()

print(p_map)

ggsave(
  "maxent_csv_env_prediction.png",
  plot = p_map,
  width = 10,
  height = 8,
  dpi = 300
)

saveRDS(mx, "maxent_csv_env_model.rds")

cat("Saved: maxent_csv_env_prediction.png\n")
cat("Saved: maxent_csv_env_ROC.png\n")
cat("Saved: maxent_csv_env_model.rds\n")